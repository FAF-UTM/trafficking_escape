# Copy to .env (git-ignored) and fill in. Read by docker-compose and passed to the backend.

# Required: OpenAI API key used for the chat simulation.
OPENAI_API_KEY=
# Model for the chat simulation (default gpt-6-luna).
OPENAI_MODEL=gpt-6-luna
# Optional: reasoning effort sent to the Responses API (default low; empty to omit).
#OPENAI_REASONING_EFFORT=low

# Required: JWT signing key, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Optional: token lifetime (default 3h).
#JWT_TTL=3h

# Optional: comma-separated frontend origins allowed by CORS.
#CORS_ALLOWED_ORIGINS=http://localhost:5173,https://traffickingescape.com,https://www.traffickingescape.com

# Optional: creates the first admin on startup if it does not exist (password >= 12 chars).
#ADMIN_USERNAME=
#ADMIN_PASSWORD=
#ADMIN_EMAIL=
